# Specrun – Caddy auf dem Hetzner-Server (Level 8).
# Jeder Lauf ist unter https://<RUN_ID>.<LIVE_DOMAIN> erreichbar, z. B. https://lauf-008.89-67-45-123.sslip.io.
# Caddy leitet an den Frontend-Container <RUN_ID>-web:8080 im Docker-Netz „web“ weiter.
# Zertifikate holt Caddy beim ersten Aufruf (On-Demand TLS), aber nur für erlaubte Namen (siehe /erlaubt).
# LIVE_DOMAIN kommt aus der Umgebung des Containers (compose.yml, .env).
{
	on_demand_tls {
		ask http://127.0.0.1:5555/erlaubt
	}
}

# Darf Caddy für diesen Namen ein Zertifikat holen? Nur lauf-<nr>.<LIVE_DOMAIN> und referenz.<LIVE_DOMAIN>.
http://127.0.0.1:5555 {
	bind 127.0.0.1
	@erlaubt expression `{query.domain}.matches("^(lauf-[0-9]+|referenz)\\.") && {query.domain}.endsWith(".{$LIVE_DOMAIN}")`
	respond @erlaubt 200
	respond 404
}

http:// {
	redir https://{host}{uri} permanent
}

https:// {
	tls {
		on_demand
	}
	# Erstes Namensteil = RUN_ID, z. B. lauf-008
	# Komprimieren übernimmt Caddy: nginx komprimiert weitergeleitete Anfragen (Header „Via“) nicht.
	# Ab 256 Bytes wie in der nginx-Konfiguration der Spec (Caddy-Standard wäre 512)
	encode {
		zstd
		gzip
		minimum_length 256
	}
	# (handle-Blöcke, weil Caddy „respond“ sonst vor „reverse_proxy“ einsortiert)
	@lauf vars_regexp lauf {host} ^([a-z0-9-]+)\.
	handle @lauf {
		reverse_proxy {re.lauf.1}-web:8080
	}
	handle {
		respond 404
	}
}
