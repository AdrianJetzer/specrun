{
  // Specrun: Umgebung für einen Nachbau-Lauf.
  // Wird von runner/prepare-run.sh nach <lauf>/env/.devcontainer kopiert.
  "name": "specrun",
  "build": { "dockerfile": "Dockerfile" },

  "remoteUser": "dev",
  "containerUser": "dev",
  "updateRemoteUserUID": false,

  // Podman (rootless): Mac-Benutzer wird im Container zu "dev" (UID 1000)
  "runArgs": ["--userns=keep-id:uid=1000,gid=1000"],

  // Geöffnet wird <lauf>/env (enthält nur .devcontainer/).
  // Der Agent arbeitet im Nachbarordner <lauf>/work (enthält zu Beginn nur spec/)
  // und sieht die Container-Konfiguration damit nicht.
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder}/../work,target=/workspace,type=bind",

  // Kein Volume für Claude: Jeder Lauf startet mit leerem Gedächtnis (keine Memory, Sessions, Plugins
  // aus früheren Läufen). Die Anmeldung kommt nur über ein Token, das auf dem Mac als Umgebungsvariable
  // gesetzt ist (einmalig erzeugt mit `claude setup-token`, siehe README).
  // GH_TOKEN: eng begrenztes Token des Agenten für die Organisation specrun-lab (ab Level 6)
  // RUN_ID: Kennung des Laufs (setzt runner/prepare-run.sh ein), Repo heißt specrun-lab/levelboard-<RUN_ID>
  // ANTHROPIC_MODEL: fest vorgegebenes Modell für vergleichbare Läufe (setzt runner/prepare-run.sh ein,
  // Standard claude-sonnet-5-5, wählbar mit --modell)
  "containerEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "GH_TOKEN": "${localEnv:SPECRUN_AGENT_GH_TOKEN}",
    "RUN_ID": "__RUN_ID__",
    "ANTHROPIC_MODEL": "__MODEL__"
  },

  // Session-Protokolle von Claude landen im Laufordner (<lauf>/protokoll) – für die Messung der Tokens
  // pro Level. Nur dieser Unterordner wird eingehängt; Memory und Einstellungen bleiben pro Container frisch.
  "mounts": ["source=${localWorkspaceFolder}/../protokoll,target=/home/dev/.claude/projects,type=bind"],

  "forwardPorts": [8080],

  "customizations": {
    "vscode": { "extensions": ["anthropic.claude-code"] }
  },

  "postCreateCommand": "node -v && npm -v && go version && nginx -v && gh --version | head -1 && claude --version"
}
