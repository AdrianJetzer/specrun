{
  // Specrun: Umgebung für den unabhängigen Prüfer.
  // Wird von runner/prepare-run.sh nach <lauf>/judge/.devcontainer kopiert;
  // dabei werden __SPECRUN__ (Pfad zu Specrun) und __LAUF__ (Laufnummer) eingesetzt.
  // Gleiches Image wie der Agent (Dockerfile identisch mit infra/devcontainer).
  "name": "specrun-pruefer-__LAUF__",
  "build": { "dockerfile": "Dockerfile" },

  "remoteUser": "dev",
  "containerUser": "dev",
  "updateRemoteUserUID": false,
  "runArgs": ["--userns=keep-id:uid=1000,gid=1000"],

  // Arbeitsordner = <lauf>/judge: hier landen die Ergebnisse (ergebnis/)
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  // Nur lesbar: der ganze Laufordner (Werk des Agenten unter /lauf/work) und Specrun (Prüfer, Spec)
  "mounts": [
    "source=${localWorkspaceFolder}/..,target=/lauf,type=bind,readonly",
    // Session-Protokoll des Agenten dort, wo seine Prüfsuite es sucht: make check im Prüfer rechnet so dieselben Tokens
    "source=${localWorkspaceFolder}/../protokoll,target=/home/dev/.claude/projects,type=bind,readonly",
    "source=__SPECRUN__,target=/specrun,type=bind,readonly"
  ],

  // GH_TOKEN: Lese-Token des Prüfers für specrun-lab (Pipeline, Artefakte; ab Level 6)
  "containerEnv": {
    "SPECRUN_LAUF": "__LAUF__",
    "RUN_ID": "lauf-__LAUF__",
    "GH_TOKEN": "${localEnv:SPECRUN_JUDGE_GH_TOKEN}",
    "LIVE_DOMAIN": "${localEnv:SPECRUN_LIVE_DOMAIN}"
  },

  "postCreateCommand": "echo 'Prüfer bereit. Starten mit: /specrun/runner/pruefen.sh'"
}
